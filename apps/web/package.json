{
	"name": "@learnquiz/web",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"generate-routes": "tsr generate",
		"build": "vite build",
		"preview": "pnpm run build && vite preview",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types --env-file .dev.vars.example",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"db:migrate:local": "wrangler d1 migrations apply learnquiz --local",
		"seed:northwind": "node seed/run-northwind.mjs"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "1.7.27",
		"@learnquiz/api": "workspace:*",
		"@learnquiz/tokens": "workspace:*",
		"@tailwindcss/vite": "4.3.5",
		"@tanstack/react-devtools": "0.10.15",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-router-devtools": "1.167.4",
		"@tanstack/react-start": "1.169.7",
		"better-auth": "1.7.27",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"drizzle-orm": "0.45.4",
		"lucide-react": "1.77.0",
		"motion": "14.14.0",
		"radix-ui": "1.8.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"tailwind-merge": "3.7.1",
		"tailwindcss": "4.3.5",
		"ts-fsrs": "6.0.0",
		"unpdf": "2.2.1",
		"uqr": "0.1.3",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.70.1",
		"@tanstack/devtools-vite": "0.8.7",
		"@tanstack/router-cli": "1.168.0",
		"@types/node": "24.19.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.3.0",
		"drizzle-kit": "0.31.11",
		"happy-dom": "21.0.4",
		"typescript": "7.0.2",
		"vite": "8.3.8",
		"vitest": "5.1.1",
		"wrangler": "4.165.0"
	}
}
