{
  // Deploy-time edge limit (set in the Cloudflare dashboard, WAF > Rate limiting rules):
  // POST requests to app.learnquiz.com, 10 per minute per IP, block. The per-learner daily
  // model cap in the worker is the second layer; this rule stops one IP minting guests.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learnquiz",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker.ts",
  "observability": { "enabled": true },
  "upload_source_maps": true,
  // Per-minute sweep that drains pending company-topic question generation (waitUntil alone stops about 30 s after the response).
  "triggers": { "crons": ["* * * * *"] },
  "routes": [
    { "pattern": "app.learnquiz.com", "custom_domain": true }
  ],
  // No model is configured in production: new topics and questions show as unavailable, and sessions, placement
  // lines and grading use their rule and template fallbacks. COMPANY_GENERATION_ENABLED stays unset: company
  // curricula, shared questions and procedure flowcharts are paused. Diagrams and voice answers have no model path.
  "vars": {
    "BETTER_AUTH_URL": "https://app.learnquiz.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "learnquiz",
      "database_id": "0aee5b26-bd1b-4a9f-ad44-8d95454d8ebf",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "learnquiz-media" }]
}
